{
  "name": "lensboard-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @lensboard/desktop dev",
    "showcase": "vite",
    "build": "tsc -b",
    "build:packages": "pnpm -r run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:boundaries": "node scripts/verify-boundaries.mjs",
    "test:e2e": "node tests/e2e/runner.ts",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:boundaries && pnpm run test:e2e",
    "verify:npm": "npm run build && npm run typecheck && npm run lint && npm run test && npm run test:boundaries && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.1",
    "eslint-import-resolver-typescript": "^3.8.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.4",
    "vitest": "^3.0.5"
  }
}
