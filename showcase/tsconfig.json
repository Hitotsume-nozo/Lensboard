{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@lensboard/core": ["../packages/core/src/index.ts"],
